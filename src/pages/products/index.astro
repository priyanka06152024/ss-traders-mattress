
---
import MainLayout from "../../layouts/MainLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { products } from "../../data/products.js";

const categories = [
  "Orthopedic Mattresses",
  "Foam Mattresses",
  "Rebonded / Bonded Mattresses",
  "Spring Mattresses",
  "Memory Foam Mattresses",
  "PU Foam",
  "HR Foam",
];
---

<MainLayout
  title="Mattress Products | SS Traders Mattress Aligarh"
  description="Explore orthopedic, foam, rebonded, spring, memory foam, PU foam and HR foam products at SS Traders Mattress in Aligarh."
>
  <!-- HERO -->
<section class="product-hero">
  <div class="product-hero-image" aria-hidden="true"></div>
  <div class="product-hero-overlay" aria-hidden="true"></div>

  <div class="container-wide product-hero-content">
    <p class="eyebrow">EXPLORE OUR COLLECTION</p>

    <h1 class="product-hero-title">
      Comfort begins with<br />
      <span>the right choice.</span>
    </h1>

    <p class="product-hero-description">
      Discover mattress and foam solutions designed around different
      comfort preferences, sleeping needs and budgets.
    </p>

    <div class="product-hero-meta">
      <span>SS TRADERS MATTRESS</span>
      <span>ALIGARH, UTTAR PRADESH</span>
    </div>
  </div>
</section>

  <!-- CATEGORY STRIP -->
  <section class="category-strip">
    <div class="container-wide">
      <p class="category-strip-label">EXPLORE BY CATEGORY</p>
      <div class="category-list">
        {categories.map((category) => (
          <span class="category-pill">{category}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCT COLLECTION -->
  <section class="product-collection">
    <div class="container-wide">

      <div class="product-section-heading">
        <div>
          <p class="eyebrow">OUR PRODUCTS</p>
          <h2 class="section-title mt-3">Explore the collection.</h2>
          <p class="product-section-description">
            Find the right mattress or foam option for your comfort needs.
            Contact us for product specifications and availability.
          </p>
        </div>

        <div class="product-count">
          <strong>{products.length.toString().padStart(2, "0")}</strong>
          <span>PRODUCTS</span>
        </div>
      </div>

      <div class="product-grid">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

    </div>
  </section>

  <!-- BUYING ASSISTANCE -->
  <section class="product-help">
    <div class="container-wide">
      <div class="product-help-inner">
        <div>
          <p class="eyebrow">NEED HELP CHOOSING?</p>
          <h2>Not sure which mattress is right for you?</h2>
          <p>
            Talk to our team about your comfort preferences, product options
            and available sizes.
          </p>
        </div>

        <a
          href="https://wa.me/918273238363?text=Hello%20SS%20Traders%2C%20I%20need%20help%20choosing%20a%20mattress."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary product-help-button"
        >
          Enquire on WhatsApp <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <style>
   /* PRODUCT HERO */

.product-hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding: 105px 0 85px;
  min-height: 510px;
  display: flex;
  align-items: center;
  background: var(--navy);
  color: white;
}

.product-hero-image {
  position: absolute;
  inset: 0;
  z-index: -2;
  background-image: url("https://images.unsplash.com/photo-1560185128-e173042f79dd?auto=format&fit=crop&w=2400&q=85");
  background-size: cover;
  background-position: center 55%;
  transform: scale(1.02);
}

.product-hero-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(
    90deg,
    rgba(0, 25, 58, 0.72) 0%,
    rgba(0, 37, 86, 0.35) 48%,
    rgba(0, 37, 86, 0.08) 100%
  );
}

.product-hero-content {
  position: relative;
  z-index: 2;
}

.product-hero .eyebrow {
  color: var(--gold);
}

.product-hero-title {
  margin-top: 24px;
  max-width: 850px;
  font-size: clamp(44px, 7vw, 84px);
  line-height: 1.04;
  letter-spacing: -3px;
  font-weight: 600;
}

.product-hero-title span {
  color: var(--gold);
}

.product-hero-description {
  max-width: 560px;
  margin-top: 25px;
  color: rgba(255,255,255,.9);
  font-size: 15px;
  line-height: 1.9;
}

.product-hero-meta {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 75px;
  padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,.35);
  color: rgba(255,255,255,.85);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

    .category-strip {
      padding: 30px 0;
      background: #fff;
      border-bottom: 1px solid #E9ECF0;
    }

    .category-strip-label {
      margin-bottom: 16px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
    }

    .category-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .category-pill {
      padding: 10px 16px;
      border: 1px solid #E4E7EC;
      border-radius: 50px;
      color: var(--navy);
      font-size: 12px;
      font-weight: 600;
      transition: .3s ease;
    }

    .category-pill:hover {
      background: var(--navy);
      color: white;
      border-color: var(--navy);
    }

    .product-collection {
      padding: 100px 0 115px;
      background: var(--paper);
    }

    .product-section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 30px;
      margin-bottom: 55px;
    }

    .product-section-description {
      max-width: 540px;
      margin-top: 15px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.8;
    }

    .product-count {
      display: flex;
      flex-direction: column;
      align-items: end;
      padding-bottom: 5px;
    }

    .product-count strong {
      color: var(--navy);
      font-size: 42px;
      line-height: 1;
    }

    .product-count span {
      margin-top: 7px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 30px;
    }

    .product-help {
      padding: 80px 0;
      background: white;
    }

    .product-help-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
      padding: 55px;
      background: var(--navy);
      color: white;
    }

    .product-help .eyebrow {
      color: var(--gold);
    }

    .product-help h2 {
      max-width: 570px;
      margin-top: 15px;
      font-size: clamp(28px, 4vw, 43px);
      line-height: 1.2;
      font-weight: 600;
    }

    .product-help p:not(.eyebrow) {
      max-width: 500px;
      margin-top: 14px;
      color: rgba(255,255,255,.7);
      font-size: 14px;
      line-height: 1.8;
    }

    .product-help-button {
      flex-shrink: 0;
    }

    @media (max-width: 900px) {
      .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
      }

      .product-help-inner {
        padding: 40px;
      }
    }

    @media (max-width: 600px) {
      .product-hero {
        padding: 75px 0 60px;
      }

      .product-hero-title {
        letter-spacing: -1.8px;
      }

      .product-hero-meta {
        margin-top: 45px;
        font-size: 8px;
      }

      .product-section-heading {
        align-items: start;
      }

      .product-count strong {
        font-size: 30px;
      }

      .product-collection {
        padding: 70px 0;
      }

      .product-grid {
        grid-template-columns: 1fr;
        gap: 25px;
      }

      .product-help {
        padding: 55px 0;
      }

      .product-help-inner {
        align-items: start;
        flex-direction: column;
        padding: 30px 24px;
      }
    }
  </style>
</MainLayout>
