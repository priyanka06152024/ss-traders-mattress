
---
import MainLayout from "../layouts/MainLayout.astro";

const gstPages = [
  "/images/gstPage1.webp",
  "/images/gstPage2.webp",
  "/images/gstPage3.webp",
];

const certificatePages = [
  "/images/certificatePage1.webp",
  "/images/certificatePage2.webp",
  "/images/certificatePage3.webp",
];

const udyamPages = [
  "/images/udyam-page-1.webp",
];

const products = [
  {
    number: "01",
    title: "Orthopedic Mattresses",
    description: "Mattress options designed for people looking for supportive sleeping comfort."
  },
  {
    number: "02",
    title: "Foam Mattresses",
    description: "Everyday foam mattress options available in different comfort preferences."
  },
  {
    number: "03",
    title: "Rebonded / Bonded Mattresses",
    description: "Rebonded foam solutions for customers with different support requirements."
  },
  {
    number: "04",
    title: "Spring Mattresses",
    description: "Spring-based mattress options for a different sleeping experience."
  },
  {
    number: "05",
    title: "Memory Foam Mattresses",
    description: "Memory foam options designed to adapt to body contours and sleeping preferences."
  },
  {
    number: "06",
    title: "PU & HR Foam",
    description: "Foam product solutions for a variety of comfort and usage requirements."
  }
];

const reasons = [
  ["01", "Product Variety", "Multiple mattress and foam categories in one place."],
  ["02", "Customer Focus", "Understanding different comfort preferences and requirements."],
  ["03", "Quality Focus", "Committed to offering products with attention to quality and durability."],
  ["04", "Local Presence", "Convenient local contact and product enquiries in Aligarh."]
];
---

<MainLayout
  title="About SS Traders Mattress | Mattress & Foam Supplier in Aligarh"
  description="Discover SS Traders Mattress, your Aligarh-based supplier of orthopedic, foam, spring, memory foam and other mattress solutions."
>
  <!-- HERO -->
  
<section class="about-hero relative overflow-hidden bg-[var(--navy)] py-24 text-white md:py-32">
  <div class="about-hero-image" aria-hidden="true"></div>
  <div class="about-hero-overlay" aria-hidden="true"></div>

  <div class="container-wide relative z-10">
    <p class="eyebrow">WHO WE ARE</p>

    <h1 class="mt-5 max-w-4xl text-5xl font-extrabold tracking-[-.05em] sm:text-6xl lg:text-7xl">
      Comfort begins with
      <span class="text-[var(--gold-light)]">the right choice.</span>
    </h1>

    <p class="mt-7 max-w-2xl text-base leading-8 text-white/80 md:text-lg">
      Your trusted destination for mattress and foam products in Aligarh,
      Uttar Pradesh. We believe better comfort starts with better choices.
    </p>

    <a href="/contact" class="about-btn mt-9 inline-flex">
      Get in Touch <span>↗</span>
    </a>
  </div>

  <div class="hero-decoration" aria-hidden="true">SS</div>
</section>


  <!-- ABOUT INTRODUCTION -->
  <section class="container-wide grid gap-12 py-20 md:grid-cols-2 md:items-center md:py-28">
    <div>
      <p class="eyebrow">ABOUT SS TRADERS</p>

      <h2 class="section-title mt-4">
        Quality comfort for a better everyday experience.
      </h2>

      <div class="gold-line mt-7"></div>

      <p class="mt-7 text-sm leading-8 text-[var(--muted)]">
        At SS Traders Mattress, we understand that comfort is an important
        part of everyday living. That's why we offer a range of mattress
        and foam products designed to suit different sleeping preferences,
        comfort needs and budgets.
      </p>
    </div>

    <div class="about-content space-y-5 text-[var(--muted)]">
      <p>
        SS Traders Mattress is a mattress and foam products supplier based
        in Aligarh, Uttar Pradesh. We are committed to providing quality
        mattress and foam solutions with a focus on comfort, durability
        and customer requirements.
      </p>

      <p>
        Our product range includes Orthopedic Mattresses, Foam Mattresses,
        Rebonded/Bonded Mattresses, Spring Mattresses, Memory Foam
        Mattresses, PU Foam and HR Foam products.
      </p>

      <p>
        Whether you are looking for everyday sleeping comfort, additional
        support or a particular foam solution, we aim to help you explore
        suitable product options.
      </p>

      <p>
        Customer satisfaction, product quality and reliable service remain
        important to the way we serve our customers.
      </p>
    </div>
  </section>

  <!-- PRODUCT RANGE -->
  <section class="bg-[var(--paper)] py-20 md:py-28">
    <div class="container-wide">
      <div class="max-w-2xl">
        <p class="eyebrow">WHAT WE OFFER</p>

        <h2 class="section-title mt-4">
          Explore our range of mattress & foam products.
        </h2>

        <p class="mt-5 text-sm leading-8 text-[var(--muted)]">
          Different people have different comfort preferences. Explore
          our product categories and find options that match your needs.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <article class="product-box group">
            <div class="flex items-center justify-between">
              <span class="product-number">{product.number}</span>
              <span class="product-star">✦</span>
            </div>

            <h3>{product.title}</h3>
            <p>{product.description}</p>

            <a href="/contact" aria-label={`Enquire about ${product.title}`}>
              Enquire Now <span>↗</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="container-wide py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <p class="eyebrow">WHY SS TRADERS</p>

        <h2 class="section-title mt-4">
          More than products. A focus on your comfort.
        </h2>

        <p class="mt-6 text-sm leading-8 text-[var(--muted)]">
          We believe choosing the right mattress or foam product should
          be simple and convenient. Our focus is to help customers explore
          product options according to their individual needs.
        </p>

        <a href="/contact" class="about-btn mt-8 inline-flex">
          Talk to Our Team <span>↗</span>
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {reasons.map(([number, title, description]) => (
          <article class="why-card">
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR COMMITMENT -->
  <section class="commitment-section bg-[var(--navy)] py-20 text-white md:py-24">
    <div class="container-wide">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">OUR COMMITMENT</p>

        <h2 class="text-4xl font-bold tracking-[-.04em] md:text-5xl">
          Your comfort matters.
          <span class="text-[var(--gold-light)]">Every day.</span>
        </h2>

        <p class="mt-7 text-sm leading-8 text-white/65 md:text-base">
          Our aim is to make mattress and foam product selection easier
          through a range of options and helpful customer interaction.
          We value customer trust and continuously focus on providing
          a positive buying experience.
        </p>
      </div>
    </div>
  </section>



  <!-- GST CERTIFICATE SECTION -->
  <section class="gst-certificate-section">
    <div class="container-wide">
      <div class="gst-heading">
        <div>
          <p class="eyebrow">TAX REGISTRATION</p>

          <h2 class="section-title">
            GST registration.
            <span>Documented transparency.</span>
          </h2>

          <p>
            View the GST registration document provided by SS Traders
            Mattress. All three pages are available in the document viewer.
          </p>
        </div>

        <div class="gst-heading-mark">
          <span>GST</span>
          <small>REGISTRATION</small>
        </div>
      </div>

      <div class="gst-document-layout">
        <button
          type="button"
          class="gst-document-preview"
          data-viewer-open="gst"
          aria-label="Open GST registration certificate"
        >
          <img
            src={gstPages[0]}
            alt="First page of GST registration certificate"
            loading="lazy"
          />

          <span class="gst-preview-shade">
            <span class="gst-zoom-icon">↗</span>
            <strong>VIEW FULL GST CERTIFICATE</strong>
            <small>3 DOCUMENT PAGES</small>
          </span>

          <span class="gst-page-number">PAGE 01 / 03</span>
        </button>

        <div class="gst-document-details">
          <span class="gst-document-kicker">GST REGISTRATION DOCUMENT</span>

          <h3>GST Registration Certificate</h3>

          <p>
            This document contains the GST registration information
            provided by SS Traders Mattress. Open the preview to navigate
            through all three pages.
          </p>

          <div class="gst-detail-row">
            <span class="gst-detail-icon">GST</span>

            <div>
              <strong>GST Registration Certificate</strong>
              <small>Image document · 3 pages</small>
            </div>
          </div>

          <div class="gst-detail-actions">
            <button
              type="button"
              data-viewer-open="gst"
              class="gst-view-btn"
            >
              View GST Certificate <span>↗</span>
            </button>

            <a
              href={gstPages[0]}
              download="SS-Traders-GST-Page-1.webp"
              class="gst-download-btn"
              aria-label="Download GST certificate page"
            >
              ↓
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CERTIFICATE SECTION -->
  <section class="gst-certificate-section certificate-section">
    <div class="container-wide">
      <div class="gst-heading">
        <div>
          <p class="eyebrow">BUSINESS CERTIFICATE</p>

          <h2 class="section-title">
            Business certificate.
            <span>Our official document.</span>
          </h2>

          <p>
            View the certificate document provided by SS Traders Mattress.
            All three pages are available in the document viewer.
          </p>
        </div>

        <div class="gst-heading-mark certificate-heading-mark">
          <span>DOC</span>
          <small>CERTIFICATE</small>
        </div>
      </div>

      <div class="gst-document-layout">
        <button
          type="button"
          class="gst-document-preview"
          data-viewer-open="certificate"
          aria-label="Open business certificate"
        >
          <img
            src={certificatePages[0]}
            alt="First page of business certificate"
            loading="lazy"
          />

          <span class="gst-preview-shade">
            <span class="gst-zoom-icon">↗</span>
            <strong>VIEW FULL CERTIFICATE</strong>
            <small>3 DOCUMENT PAGES</small>
          </span>

          <span class="gst-page-number">PAGE 01 / 03</span>
        </button>

        <div class="gst-document-details">
          <span class="gst-document-kicker">OFFICIAL BUSINESS DOCUMENT</span>

          <h3>Business Certificate</h3>

          <p>
            This document contains the certificate information
            provided by SS Traders Mattress. Open the preview to navigate
            through all three pages.
          </p>

          <div class="gst-detail-row">
            <span class="gst-detail-icon">DOC</span>

            <div>
              <strong>Business Certificate</strong>
              <small>Image document · 3 pages</small>
            </div>
          </div>

          <div class="gst-detail-actions">
            <button
              type="button"
              data-viewer-open="certificate"
              class="gst-view-btn"
            >
              View Certificate <span>↗</span>
            </button>

            <a
              href={certificatePages[0]}
              download="SS-Traders-Certificate-Page-1.webp"
              class="gst-download-btn"
              aria-label="Download certificate page"
            >
              ↓
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- UDYAM DOCUMENT VIEWER -->
  <div
    class="document-lightbox"
    data-document-viewer="udyam"
    data-pages={JSON.stringify(udyamPages)}
    aria-hidden="true"
  >
    <div class="lightbox-header">
      <div>
        <span>SS TRADERS MATTRESS · BUSINESS REGISTRATION</span>
        <h3>Udyam Registration Certificate</h3>
      </div>

      <button type="button" data-viewer-close aria-label="Close viewer">
        ×
      </button>
    </div>

    <div class="lightbox-body">
      <button type="button" data-viewer-prev aria-label="Previous page">
        ←
      </button>

      <div class="lightbox-image-wrap">
        <img
          src={udyamPages[0]}
          alt="Udyam certificate page 1"
          data-viewer-image
        />
      </div>

      <button type="button" data-viewer-next aria-label="Next page">
        →
      </button>
    </div>

    <div class="lightbox-footer">
      <span>
        <b data-viewer-current>01</b> /
        <span data-viewer-total>01</span>
      </span>

      <div class="lightbox-progress">
        <span data-viewer-progress></span>
      </div>

      <a
        href="https://udyamregistration.gov.in/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Official Portal ↗
      </a>
    </div>
  </div>

  <!-- GST DOCUMENT VIEWER -->
  <div
    class="document-lightbox"
    data-document-viewer="gst"
    data-pages={JSON.stringify(gstPages)}
    aria-hidden="true"
  >
    <div class="lightbox-header">
      <div>
        <span>SS TRADERS MATTRESS · TAX REGISTRATION</span>
        <h3>GST Registration Certificate</h3>
      </div>

      <button type="button" data-viewer-close aria-label="Close viewer">
        ×
      </button>
    </div>

    <div class="lightbox-body">
      <button type="button" data-viewer-prev aria-label="Previous page">
        ←
      </button>

      <div class="lightbox-image-wrap">
        <img
          src={gstPages[0]}
          alt="GST certificate page 1"
          data-viewer-image
        />
      </div>

      <button type="button" data-viewer-next aria-label="Next page">
        →
      </button>
    </div>

    <div class="lightbox-footer">
      <span>
        <b data-viewer-current>01</b> /
        <span data-viewer-total>03</span>
      </span>

      <div class="lightbox-progress">
        <span data-viewer-progress></span>
      </div>

      <a
        href={gstPages[0]}
        download="SS-Traders-GST-Page-1.webp"
      >
        Download Page ↓
      </a>
    </div>
  </div>

  <!-- CERTIFICATE DOCUMENT VIEWER -->
  <div
    class="document-lightbox"
    data-document-viewer="certificate"
    data-pages={JSON.stringify(certificatePages)}
    aria-hidden="true"
  >
    <div class="lightbox-header">
      <div>
        <span>SS TRADERS MATTRESS · BUSINESS CERTIFICATE</span>
        <h3>Business Certificate</h3>
      </div>

      <button type="button" data-viewer-close aria-label="Close viewer">
        ×
      </button>
    </div>

    <div class="lightbox-body">
      <button type="button" data-viewer-prev aria-label="Previous page">
        ←
      </button>

      <div class="lightbox-image-wrap">
        <img
          src={certificatePages[0]}
          alt="Business certificate page 1"
          data-viewer-image
        />
      </div>

      <button type="button" data-viewer-next aria-label="Next page">
        →
      </button>
    </div>

    <div class="lightbox-footer">
      <span>
        <b data-viewer-current>01</b> /
        <span data-viewer-total>03</span>
      </span>

      <div class="lightbox-progress">
        <span data-viewer-progress></span>
      </div>

      <a
        href={certificatePages[0]}
        download="SS-Traders-Certificate-Page-1.webp"
      >
        Download Page ↓
      </a>
    </div>
  </div>

  <!-- FINAL CTA -->
  <section class="bg-[var(--paper)] py-20 md:py-24">
    <div class="container-wide text-center">
      <p class="eyebrow">LET'S CONNECT</p>

      <h2 class="mx-auto max-w-3xl text-4xl font-bold tracking-[-.04em] text-[var(--navy)] md:text-5xl">
        Looking for the right comfort?
        <span class="text-[var(--gold)]">Let's talk.</span>
      </h2>

      <p class="mx-auto mt-5 max-w-xl text-sm leading-8 text-[var(--muted)]">
        Get in touch with SS Traders Mattress for product information,
        enquiries and assistance.
      </p>

      <a href="/contact" class="about-btn mt-8 inline-flex">
        Contact Us <span>↗</span>
      </a>
    </div>
  </section>

  <style>
    /* HERO & GENERAL */
/* ABOUT HERO */

.about-hero {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  min-height: 510px;
  padding: 90px 0;
  overflow: hidden;
  background: var(--navy);
  color: white;
}

.about-hero-image {
  position: absolute;
  inset: 0;
  z-index: -2;
  background-image: url("https://images.unsplash.com/photo-1560185128-e173042f79dd?auto=format&fit=crop&w=2400&q=85");
  background-size: cover;
  background-position: center 55%;
  transform: scale(1.02);
}

.about-hero-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(
    90deg,
    rgba(0, 25, 58, 0.55) 0%,
    rgba(0, 37, 86, 0.24) 48%,
    rgba(0, 37, 86, 0.04) 100%
  );
}

.about-hero-content {
  position: relative;
  z-index: 2;
}

.about-hero .eyebrow {
  color: var(--gold);
}

.about-hero-title {
  max-width: 850px;
  margin-top: 20px;
  color: white;
  font-size: clamp(38px, 5.5vw, 66px);
  font-weight: 600;
  line-height: 1.12;
  letter-spacing: -2px;
}

.about-hero-title span {
  display: block;
  color: var(--gold-light);
}

.about-hero-description {
  max-width: 560px;
  margin-top: 22px;
  color: rgba(255, 255, 255, 0.9);
  font-size: 14px;
  line-height: 1.9;
}

.hero-decoration {
  position: absolute;
  right: 5%;
  bottom: -75px;
  z-index: 1;
  color: rgba(255, 255, 255, 0.055);
  font-size: clamp(160px, 25vw, 340px);
  font-weight: 800;
  line-height: 1;
  pointer-events: none;
}

/* MOBILE */

@media (max-width: 640px) {
  .about-hero {
    min-height: 450px;
    padding: 75px 0;
  }

  .about-hero-image {
    background-position: 60% center;
  }

  .about-hero-overlay {
    background: linear-gradient(
      90deg,
      rgba(0, 25, 58, 0.58),
      rgba(0, 37, 86, 0.18)
    );
  }

  .about-hero-title {
    font-size: clamp(36px, 9vw, 48px);
    letter-spacing: -1.3px;
  }

  .about-hero-description {
    font-size: 13px;
  }

  .hero-decoration {
    right: 3%;
    bottom: -25px;
    font-size: 150px;
  }
}

    .about-btn {
      align-items: center;
      justify-content: center;
      gap: 35px;
      padding: 16px 23px;
      background: var(--gold);
      color: var(--navy);
      font-size: 12px;
      font-weight: 700;
      transition: .3s ease;
    }

    .about-btn:hover {
      background: var(--gold-light);
      transform: translateY(-3px);
    }

    .about-btn span { font-size: 17px; }

    .about-content p {
      font-size: 14px;
      line-height: 2;
    }

    /* PRODUCT CARDS */

    .product-box {
      padding: 30px;
      min-height: 260px;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      background: white;
      transition: .35s ease;
    }

    .product-box:hover {
      transform: translateY(-7px);
      border-color: var(--gold);
      box-shadow: 0 18px 40px rgba(0,37,86,.08);
    }

    .product-number {
      color: var(--gold);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
    }

    .product-star { color: var(--gold); font-size: 21px; }

    .product-box h3 {
      margin-top: 35px;
      color: var(--navy);
      font-size: 19px;
      font-weight: 700;
    }

    .product-box p {
      margin-top: 12px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.9;
    }

    .product-box a {
      display: inline-flex;
      gap: 10px;
      align-items: center;
      margin-top: 22px;
      color: var(--navy);
      font-size: 12px;
      font-weight: 700;
      transition: .3s ease;
    }

    .product-box a:hover { color: var(--gold); gap: 16px; }

    /* WHY CHOOSE US */

    .why-card {
      padding: 25px;
      border: 1px solid #e8e8e8;
      border-radius: 12px;
      transition: .3s ease;
    }

    .why-card:hover {
      border-color: var(--gold);
      background: var(--paper);
      transform: translateY(-4px);
    }

    .why-card > span {
      color: var(--gold);
      font-size: 12px;
      font-weight: 700;
    }

    .why-card h3 {
      margin-top: 22px;
      color: var(--navy);
      font-size: 17px;
      font-weight: 700;
    }

    .why-card p {
      margin-top: 10px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.9;
    }

    /* UDYAM SECTION */

    .udyam-certificate-section {
      padding: 110px 0;
      background: #fff;
    }

    .udyam-heading {
      max-width: 650px;
      margin-bottom: 45px;
    }

    .udyam-heading .section-title span,
    .gst-heading .section-title span {
      color: var(--gold);
    }

    .udyam-heading > p:last-child,
    .gst-heading > div:first-child > p:last-child {
      margin-top: 18px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.9;
    }

    .udyam-certificate-layout {
      display: grid;
      grid-template-columns: .85fr 1.15fr;
      gap: 35px;
      align-items: stretch;
    }

    .udyam-certificate-info {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 42px;
      background: var(--navy);
      color: white;
    }

    .udyam-mark {
      display: grid;
      width: 55px;
      height: 55px;
      place-items: center;
      border: 1px solid rgba(254,199,58,.6);
      color: var(--gold-light);
      font-size: 26px;
      font-weight: 800;
    }

    .udyam-small-label {
      margin-top: 35px;
      color: var(--gold-light);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 2px;
    }

    .udyam-certificate-info h3 {
      margin-top: 12px;
      font-size: 29px;
      font-weight: 700;
      line-height: 1.25;
    }

    .udyam-text {
      margin-top: 15px;
      color: rgba(255,255,255,.65);
      font-size: 13px;
      line-height: 1.9;
    }

    .udyam-number-box {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: 100%;
      margin-top: 28px;
      padding: 19px;
      border-left: 3px solid var(--gold);
      background: rgba(255,255,255,.08);
    }

    .udyam-number-box span,
    .udyam-details span {
      color: rgba(255,255,255,.5);
      font-size: 9px;
      font-weight: 700;
