  </style>

  <!-- DOCUMENT VIEWER JAVASCRIPT -->
  <script>
    const viewers = document.querySelectorAll(
      "[data-document-viewer]"
    );

    let activeViewer = null;
    let activePage = 0;
    let lastFocusedElement = null;

    // GET DOCUMENT PAGES
    function getPages(viewer) {
      try {
        return JSON.parse(viewer.dataset.pages || "[]");
      } catch (error) {
        console.error("Document pages could not be loaded:", error);
        return [];
      }
    }

    // UPDATE CURRENT PAGE
    function updateViewer() {
      if (!activeViewer) return;

      const pages = getPages(activeViewer);

      if (!pages.length) return;

      const image = activeViewer.querySelector("[data-viewer-image]");
      const current = activeViewer.querySelector("[data-viewer-current]");
      const total = activeViewer.querySelector("[data-viewer-total]");
      const progress = activeViewer.querySelector("[data-viewer-progress]");
      const previous = activeViewer.querySelector("[data-viewer-prev]");
      const next = activeViewer.querySelector("[data-viewer-next]");

      if (!image) return;

      image.src = pages[activePage];
      image.alt = `Document page ${activePage + 1}`;

      if (current) {
        current.textContent = String(activePage + 1).padStart(2, "0");
      }

      if (total) {
        total.textContent = String(pages.length).padStart(2, "0");
      }

      if (progress) {
        progress.style.width =
          `${((activePage + 1) / pages.length) * 100}%`;
      }

      if (previous) {
        previous.disabled = activePage === 0;
      }

      if (next) {
        next.disabled = activePage === pages.length - 1;
      }
    }

    // OPEN VIEWER
    function openViewer(type) {
      const viewer = document.querySelector(
        `[data-document-viewer="${type}"]`
      );

      if (!viewer) {
        console.error("Viewer not found:", type);
        return;
      }

      const pages = getPages(viewer);

      if (!pages.length) {
        console.error("Document pages not found:", type);
        return;
      }

      lastFocusedElement = document.activeElement;

      if (activeViewer) {
        activeViewer.classList.remove("is-open");
        activeViewer.setAttribute("aria-hidden", "true");
      }

      activeViewer = viewer;
      activePage = 0;

      updateViewer();

      viewer.classList.add("is-open");
      viewer.setAttribute("aria-hidden", "false");

      document.body.classList.add("document-viewer-open");

      viewer.querySelector("[data-viewer-close]")?.focus();
    }

    // CLOSE VIEWER
    function closeViewer() {
      if (!activeViewer) return;

      const viewerToClose = activeViewer;

      viewerToClose.classList.remove("is-open");
      viewerToClose.setAttribute("aria-hidden", "true");

      document.body.classList.remove("document-viewer-open");

      activeViewer = null;
      activePage = 0;

      if (lastFocusedElement?.isConnected) {
        lastFocusedElement.focus();
      }

      lastFocusedElement = null;
    }

    // NEXT / PREVIOUS PAGE
    function changePage(direction) {
      if (!activeViewer) return;

      const pages = getPages(activeViewer);
      const newPage = activePage + direction;

      if (newPage < 0 || newPage >= pages.length) return;

      activePage = newPage;
      updateViewer();
    }

    // OPEN BUTTONS
    document.querySelectorAll("[data-viewer-open]").forEach((button) => {
      button.addEventListener("click", () => {
        openViewer(button.dataset.viewerOpen);
      });
    });

    // CLOSE AND NAVIGATION BUTTONS
    viewers.forEach((viewer) => {
      viewer.querySelector("[data-viewer-close]")?.addEventListener(
        "click",
        closeViewer
      );

      viewer.querySelector("[data-viewer-prev]")?.addEventListener(
        "click",
        () => changePage(-1)
      );

      viewer.querySelector("[data-viewer-next]")?.addEventListener(
        "click",
        () => changePage(1)
      );

      viewer.addEventListener("click", (event) => {
        if (event.target === viewer) {
          closeViewer();
        }
      });
    });

    // KEYBOARD CONTROLS
    document.addEventListener("keydown", (event) => {
      if (!activeViewer) return;

      if (event.key === "Escape") {
        closeViewer();
      }

      if (event.key === "ArrowRight") {
        event.preventDefault();
        changePage(1);
      }

      if (event.key === "ArrowLeft") {
        event.preventDefault();
        changePage(-1);
      }
    });
  </script>
