
---
import MainLayout from "../layouts/MainLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import HeroSlider from "../components/HeroSlider.astro";
import { products } from "../data/products.js";
import { business } from "../data/site.js";
import certificatePage1  from "../../public/images/certificatePage1.webp";
import certificatePage2 from "../../public/images/certificatePage2.webp";
import certificatePage3 from "../../public/images/certificatePage3.webp";

const featured = products.slice(0, 4);

const phoneNumber = String(business.phone || "").replace(/\D/g, "");

const whatsappNumber = phoneNumber.startsWith("91")
  ? phoneNumber
  : `91${phoneNumber}`;

const benefits = [
  {
    number: "01",
    title: "Wide Product Range",
    description: "Explore different mattress and foam categories according to your comfort preferences."
  },
  {
    number: "02",
    title: "Comfort-Focused Choices",
    description: "Find options for different sleeping preferences, support needs and budgets."
  },
  {
    number: "03",
    title: "Quality Focus",
    description: "We place importance on product quality, durability and customer requirements."
  },
  {
    number: "04",
    title: "Local Assistance",
    description: "Connect with our team in Aligarh for product information and enquiries."
  }
];

const categories = [
  "Orthopedic Mattresses",
  "Foam Mattresses",
  "Rebonded / Bonded Mattresses",
  "Spring Mattresses",
  "Memory Foam Mattresses",
  "PU Foam",
  "HR Foam"
];

const faqs = [
  {
    q: "What types of mattresses are available at SS Traders?",
    a: "Our product range includes orthopedic, foam, rebonded or bonded, spring and memory foam mattresses. Contact us to enquire about available options."
  },
  {
    q: "Do you offer orthopedic mattresses?",
    a: "Yes, orthopedic mattresses are included in our product range. You can contact our team to discuss your comfort and support requirements."
  },
  {
    q: "What is the difference between foam and spring mattresses?",
    a: "Foam mattresses use foam materials for cushioning, while spring mattresses use a spring-based support system. The right choice depends on your preferred comfort and sleeping needs."
  },
  {
    q: "Do you provide PU foam and HR foam?",
    a: "Yes, PU foam and HR foam are among the foam product categories offered by SS Traders Mattress. Contact us for product-related details."
  },
  {
    q: "How do I choose the right mattress?",
    a: "Consider your preferred firmness, sleeping position, comfort requirements and budget. Our team can help you explore different mattress categories."
  },
  {
    q: "Where is SS Traders Mattress located?",
    a: "SS Traders Mattress is based in Aligarh, Uttar Pradesh. Visit our Contact page for location details and directions."
  },
  {
    q: "How can I enquire about product prices?",
    a: "You can call or WhatsApp our team directly, or use the enquiry form on our Contact page."
  },
  {
    q: "How can I contact SS Traders Mattress?",
    a: "You can reach us through the phone and WhatsApp details provided on our website or send an enquiry through our Contact page."
  }
];

const buyingGuide = [
  {
    number: "01",
    title: "Comfort Preference",
    description: "Think about whether you prefer a soft, medium or firm sleeping surface."
  },
  {
    number: "02",
    title: "Mattress Material",
    description: "Explore foam, spring, memory foam and other available mattress types."
  },
  {
    number: "03",
    title: "Size & Space",
    description: "Choose a mattress size that suits your bed frame and available room space."
  },
  {
    number: "04",
    title: "Your Budget",
    description: "Compare suitable product options according to your budget and requirements."
  }
];
---

<MainLayout
  title="SS Traders Mattress | Quality Mattresses & Foam Products in Aligarh"
  description="Explore orthopedic, foam, spring, memory foam, PU foam and HR foam products at SS Traders Mattress in Aligarh, Uttar Pradesh."
>

  <!-- HERO -->
  <HeroSlider business={business} />


  <!-- FEATURED PRODUCTS -->
  <section class="container-wide py-20 md:py-28">

    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">FIND YOUR COMFORT</p>

      <h2 class="section-title mt-4">
        Mattress options for the way you sleep.
      </h2>

      <p class="mt-5 leading-7 text-[var(--muted)]">
        From foam to spring and support-focused options, explore our product
        range and speak with us about the right fit for your needs.
      </p>

      <div class="gold-line mx-auto mt-7"></div>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href="/products/" class="btn-outline">
        View all 7 products <span>→</span>
      </a>
    </div>

  </section>


  <!-- ABOUT -->
  <section class="about-home bg-[var(--navy)] py-20 text-white md:py-28">

    <div class="container-wide grid items-center gap-12 md:grid-cols-2">

      <div>
        <p class="eyebrow">ABOUT SS TRADERS MATTRESS</p>

        <h2 class="mt-4 text-4xl font-bold leading-tight tracking-[-.04em] sm:text-5xl">
          Comfort, choice and helpful service.
        </h2>

        <p class="mt-6 max-w-xl leading-8 text-white/70">
          Based in Aligarh, Uttar Pradesh, SS Traders Mattress offers a range
          of mattress and foam products for different comfort preferences
          and budgets. Our focus is on product choice, quality and reliable
          customer support.
        </p>

        <p class="mt-4 max-w-xl leading-8 text-white/70">
          Whether you are looking for an orthopedic mattress, foam mattress
          or a particular foam solution, we are here to help you explore
          suitable options.
        </p>

        <a href="/about/" class="mt-8 inline-flex items-center gap-3 font-bold text-[var(--gold-light)] transition hover:gap-5">
          Discover Our Story →
        </a>
      </div>

      <div class="about-image overflow-hidden rounded-2xl">
        <img
          src="https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=1100&q=82"
          alt="Comfortable bedroom with a neatly made bed"
          width="1100"
          height="850"
          loading="lazy"
          class="aspect-[5/4] w-full object-cover transition duration-700 hover:scale-105"
        />
      </div>

    </div>
  </section>


  <!-- WHY CHOOSE US -->
  <section class="container-wide py-20 md:py-28">

    <div class="max-w-2xl">
      <p class="eyebrow">WHY CHOOSE US</p>

      <h2 class="section-title mt-4">
        A better experience starts with the right choice.
      </h2>

      <p class="mt-5 leading-7 text-[var(--muted)]">
        We understand that every customer has different comfort
        requirements. Our aim is to make exploring mattress and foam
        products simple and convenient.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

      {benefits.map((item) => (
        <article class="benefit-card">

          <span class="benefit-number">{item.number}</span>

          <div class="benefit-icon">✦</div>

          <h3>{item.title}</h3>

          <p>{item.description}</p>

        </article>
      ))}

    </div>
  </section>


  <!-- PRODUCT CATEGORIES -->
  <section class="bg-[var(--paper)] py-20 md:py-28">

    <div class="container-wide">

      <div class="grid gap-8 md:grid-cols-2 md:items-end">

        <div>
          <p class="eyebrow">EXPLORE OUR RANGE</p>

          <h2 class="section-title mt-4">
            Something for every comfort preference.
          </h2>
        </div>

        <p class="max-w-lg leading-8 text-[var(--muted)] md:justify-self-end">
          Explore our mattress and foam categories. Our team can help you
          enquire about suitable options based on your requirements.
        </p>

      </div>

      <div class="category-grid mt-12">

        {categories.map((category, index) => (
          <a href="/products/" class="category-item">

            <span class="category-index">
              0{index + 1}
            </span>

            <span class="category-name">
              {category}
            </span>

            <span class="category-arrow">↗</span>

          </a>
        ))}

      </div>

      <div class="mt-10">
        <a href="/products/" class="btn-primary">
          Explore All Products ↗
        </a>
      </div>

    </div>
  </section>


  <!-- OUR COMMITMENT -->
  <section class="commitment-home bg-[var(--navy)] py-20 text-white md:py-28">

    <div class="container-wide grid gap-12 md:grid-cols-[.8fr_1.2fr] md:items-center">

      <div>
        <p class="eyebrow">OUR COMMITMENT</p>

        <h2 class="text-4xl font-bold leading-tight tracking-[-.04em] sm:text-5xl">
          Your comfort matters.
          <span class="text-[var(--gold-light)]">Every day.</span>
        </h2>
      </div>

      <div>
        <p class="text-base leading-8 text-white/70">
          At SS Traders Mattress, we believe choosing a mattress should
          be a comfortable experience too. We focus on offering different
          product options and helping customers make informed enquiries.
        </p>

        <p class="mt-5 text-base leading-8 text-white/70">
          From understanding your requirements to exploring available
          mattress and foam categories, we value every customer interaction.
        </p>

        <a href="/contact/" class="mt-8 inline-flex items-center gap-3 font-bold text-[var(--gold-light)] transition hover:gap-5">
          Talk to Our Team ↗
        </a>
      </div>

    </div>
  </section>


  <!-- BUSINESS CREDENTIALS -->
  <section class="credentials-section">

    <div class="container-wide">

      <div class="credentials-heading">

        <div>
          <span class="credentials-eyebrow">
            OUR BUSINESS CREDENTIALS
          </span>

          <h2>
            Built on trust.<br />
            <span>Backed by registration.</span>
          </h2>
        </div>

        <p>
          Explore our official business registration details and
          documentation for your reference and transparency.
        </p>

      </div>


      <div class="credentials-grid">

        <!-- UDYAM -->
        <div class="udyam-card">

          <div class="credential-icon">✓</div>

          <span class="credential-label">
             UDYAM REGISTRATION
          </span>

          <h3>
            Officially Registered<br />
            Business
          </h3>

          <p class="udyam-description">
            SS Traders Mattress shares its Udyam registration details
            for customer reference and business transparency.
          </p>

          <div class="udyam-number">

            <span>UDYAM REGISTRATION NUMBER</span>

            <strong>UDYAM-UP-02-0115192</strong>

          </div>

          <a
            href="https://udyamregistration.gov.in/"
            target="_blank"
            rel="noopener noreferrer"
            class="credential-link"
          >
            Visit Official Udyam Portal
            <span>↗</span>
          </a>

          <div class="credential-bottom">
            <span>SS TRADERS MATTRESS</span>
            <span>ALIGARH, INDIA</span>
          </div>

        </div>


        <!-- GST CERTIFICATE -->
        <div class="gst-card">

          <div class="gst-header">

            <div>
              <span class="credential-label">
                 OFFICIAL DOCUMENT
              </span>

              <h3>
                GST Registration<br />
                Certificate
              </h3>
            </div>

            <span class="pdf-tag">PDF · 3 PAGES</span>

          </div>

          <p class="gst-description">
            View the official GST registration certificate of
            SS Traders Mattress. Click the preview to explore
            all three pages.
          </p>

          <button
            class="gst-document"
            id="openGST"
            type="button"
            aria-label="Open GST registration certificate"
          >

            <img
              src={certificatePage1.src}
              alt="GST Registration Certificate first page"
              loading="lazy"
              width="900"
              height="700"
            />

            <span class="gst-document-overlay">
              <span class="gst-preview-icon">↗</span>
              VIEW CERTIFICATE
            </span>

          </button>

          <div class="gst-document-footer">

            <span>GST REGISTRATION DOCUMENT</span>

            <a href="/documents/gst-certificate.pdf" download>
              DOWNLOAD PDF ↓
            </a>

          </div>

        </div>

      </div>
    </div>
  </section>


  <!-- GST MODAL -->
  <div
    class="gst-modal"
    id="gstModal"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="GST registration certificate preview"
  >

    <button
      class="gst-close"
      id="gstClose"
      type="button"
      aria-label="Close certificate"
    >
      ×
    </button>

    <button
      class="gst-arrow"
      id="gstPrev"
      type="button"
      aria-label="Previous page"
    >
      ‹
    </button>

    <div class="gst-viewer">

      <div class="gst-slider" id="gstSlider">

        <img src={certificatePage1.src} alt="GST certificate page 1" />

        <img src={certificatePage2.src} alt="GST certificate page 2" />

        <img src={certificatePage1.src} alt="GST certificate page 3" />

      </div>

      <div class="gst-counter" id="gstCounter">
        PAGE 01 / 03
      </div>

    </div>

    <button
      class="gst-arrow"
      id="gstNext"
      type="button"
      aria-label="Next page"
    >
      ›
    </button>

  </div>


  <!-- CUSTOMER FEEDBACK -->
  <section class="feedback-section bg-[var(--paper)] py-20 md:py-24">

    <div class="container-wide grid gap-10 md:grid-cols-2 md:items-center">

      <div>
        <p class="eyebrow">CUSTOMER EXPERIENCE</p>

        <h2 class="section-title mt-4">
          Your feedback helps us serve you better.
        </h2>

        <p class="mt-5 max-w-xl leading-8 text-[var(--muted)]">
          Every enquiry and interaction matters to us. We welcome your
          questions, suggestions and feedback as we continue to serve
          customers looking for mattress and foam products.
        </p>
      </div>

      <div class="feedback-card">

        <span class="feedback-star">✦ ✦ ✦ ✦ ✦</span>

        <h3>Have you visited us?</h3>

        <p>
          Share your experience or get in touch with our team for
          product-related assistance.
        </p>

        <a href="/contact/" class="btn-primary mt-6">
          Share Your Feedback ↗
        </a>

      </div>

    </div>
  </section>


  <!-- CONTACT -->
  <section class="container-wide py-20 md:py-28">

    <div class="contact-home">

      <div class="contact-heading">

        <p class="eyebrow">GET IN TOUCH</p>

        <h2>
          Let's find the right comfort for you.
        </h2>

        <p>
          Have questions about our products? Contact SS Traders Mattress
          for product information and enquiries.
        </p>

      </div>


      <div class="contact-details">

        <div class="contact-detail">

          <span class="contact-icon">☎</span>

          <div>
            <span>CALL US</span>

            <a href={`tel:${business.phone}`}>
              {business.phone}
            </a>
          </div>

        </div>


        <div class="contact-detail">

          <span class="contact-icon">⌖</span>

          <div>
            <span>OUR LOCATION</span>

            <p>{business.address}</p>
          </div>

        </div>


        <div class="contact-actions">

          <a href="/contact/" class="contact-main-btn">
            Contact Us ↗
          </a>

          {phoneNumber && (
            <a
              href={`https://wa.me/${whatsappNumber}`}
              target="_blank"
              rel="noopener noreferrer"
              class="whatsapp-btn"
            >
              WhatsApp Us ↗
            </a>
          )}

        </div>

      </div>

    </div>
  </section>


  <!-- FINAL CTA -->
  <section class="bg-[var(--navy)] px-5 py-20 text-center text-white md:py-24">

    <div class="mx-auto max-w-3xl">

      <p class="eyebrow">
        SS TRADERS MATTRESS · ALIGARH
      </p>

      <h2 class="text-4xl font-bold leading-tight tracking-[-.04em] sm:text-5xl">
        Make comfort a part of your everyday life.
      </h2>

      <p class="mx-auto mt-5 max-w-xl leading-8 text-white/65">
        Explore our product range and connect with us to find options
        that match your comfort requirements.
      </p>

      <a href="/contact/" class="final-cta-btn mt-8 inline-flex">
        Enquire Now ↗
      </a>

    </div>
  </section>


  <!-- TESTIMONIALS -->
  <section class="testimonials-section">

    <div class="testimonials-wrapper">

      <div class="testimonials-heading">

        <span class="testimonials-label">
          OUR TESTIMONIALS
        </span>

        <h2>
          What Our <span>Customers</span> Say
        </h2>

        <p>
          Real experiences and feedback from our valued customers.
        </p>

      </div>


      <div class="testimonial-slider">

        <button
          class="testimonial-arrow testimonial-prev"
          type="button"
          aria-label="Previous testimonials"
        >
          ←
        </button>


        <div class="testimonial-track">

          {[
            {
              review: "Add your genuine customer review here. Share their experience about the mattress quality and overall service.",
              name: "Customer Name",
              initial: "C"
            },
            {
              review: "Add another genuine customer experience here. A short and honest review makes your business more trustworthy.",
              name: "Customer Name",
              initial: "C"
            },
            {
              review: "Add a third customer review here describing their experience with your products and customer support.",
              name: "Customer Name",
              initial: "C"
            },
            {
              review: "Add another genuine review from a customer who has purchased a mattress or foam product.",
              name: "Customer Name",
              initial: "C"
            }
          ].map((item, index) => (

            <article class:list={[
              "testimonial-card",
              { "featured-testimonial": index === 1 }
            ]}>

              <div class="testimonial-stars">
                ★★★★★
              </div>

              <p class="testimonial-review">
                “{item.review}”
              </p>

              <div class="testimonial-user">

                <div class="testimonial-avatar">
                  {item.initial}
                </div>

                <div>
                  <h4>{item.name}</h4>
                  <span>Customer</span>
                </div>

              </div>

            </article>

          ))}

        </div>


        <button
          class="testimonial-arrow testimonial-next"
          type="button"
          aria-label="Next testimonials"
        >
          →
        </button>

      </div>


      <div class="testimonial-pagination">

        <span class="testimonial-current">01</span>

        <span class="pagination-line">
          <span></span>
        </span>

        <span class="testimonial-total">04</span>

      </div>

    </div>
  </section>


  <!-- FAQ -->
  <section class="faq-section bg-[var(--paper)] py-20 md:py-28">

    <div class="container-wide">

      <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]">

        <div>

          <p class="eyebrow">GOT QUESTIONS?</p>

          <h2 class="section-title mt-4">
            Frequently asked questions.
          </h2>

          <p class="mt-5 max-w-md text-sm leading-8 text-[var(--muted)]">
            Find answers to common questions about our mattress and foam
            product range. If you need more information, feel free to
            contact our team.
          </p>

          <a href="/contact/" class="btn-primary mt-8 inline-flex">
            Ask Us a Question ↗
          </a>

        </div>


        <div class="faq-list">

          {faqs.map((item, index) => (

            <details class="faq-item" name="ss-faq">

              <summary>

                <span class="faq-question">

                  <span class="faq-number">
                    0{index + 1}
                  </span>

                  {item.q}

                </span>

                <span class="faq-plus">+</span>

              </summary>

              <div class="faq-answer">
                {item.a}
              </div>

            </details>

          ))}

        </div>

      </div>

    </div>
  </section>


  <!-- MATTRESS BUYING GUIDE -->
  <section class="container-wide py-20 md:py-28">

    <div class="mx-auto max-w-2xl text-center">

      <p class="eyebrow">A LITTLE GUIDANCE</p>

      <h2 class="section-title mt-4">
        Things to consider before choosing a mattress.
      </h2>

      <p class="mt-5 text-sm leading-8 text-[var(--muted)]">
        Choosing a mattress is a personal decision. Keep these important
        factors in mind when exploring your options.
      </p>

      <div class="gold-line mx-auto mt-7"></div>

    </div>


    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

      {buyingGuide.map((item) => (

        <article class="guide-card">

          <span>{item.number}</span>

          <h3>{item.title}</h3>

          <p>{item.description}</p>

        </article>

      ))}

    </div>

  </section>


  <!-- ALL HOMEPAGE STYLES -->
  <style>

    /* ABOUT IMAGE */

    .about-image img {
      display: block;
    }


    /* BENEFITS */

    .benefit-card,
    .guide-card {
      padding: 30px 25px;
      border: 1px solid #e8e8e8;
      border-radius: 14px;
      transition: .35s ease;
    }

    .benefit-card {
      min-height: 270px;
    }

    .benefit-card:hover,
    .guide-card:hover {
      transform: translateY(-7px);
      border-color: var(--gold);
      box-shadow: 0 15px 35px rgba(0,37,86,.07);
    }

    .benefit-number,
    .guide-card > span {
      color: var(--gold);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
    }

    .benefit-icon {
      margin-top: 27px;
      color: var(--gold);
      font-size: 25px;
    }

    .benefit-card h3 {
      margin-top: 18px;
      color: var(--navy);
      font-size: 18px;
      font-weight: 700;
    }

    .benefit-card p,
    .guide-card p {
      margin-top: 10px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.9;
    }


    /* CATEGORIES */

    .category-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: 1px solid #ddd;
    }

    .category-item {
      display: flex;
      align-items: center;
      gap: 18px;
      min-height: 88px;
      padding: 20px 12px;
      border-bottom: 1px solid #ddd;
      color: var(--navy);
      transition: .3s ease;
    }

    .category-item:nth-child(odd) {
      border-right: 1px solid #ddd;
    }

    .category-item:hover {
      padding-left: 22px;
      background: white;
    }

    .category-index {
      color: var(--gold);
      font-size: 11px;
      font-weight: 700;
    }

    .category-name {
      flex: 1;
      font-size: 14px;
      font-weight: 700;
    }

    .category-arrow {
      color: var(--gold);
      font-size: 18px;
    }


    /* BUSINESS CREDENTIALS */

    .credentials-section {
      padding: 110px 0;
      background: #f5f4f0;
    }

    .credentials-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 35px;
      margin-bottom: 48px;
    }

    .credentials-eyebrow,
    .credential-label {
      display: block;
      color: #a7864e;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 2px;
    }

    .credentials-heading h2 {
      margin-top: 17px;
      color: #002556;
      font-size: clamp(36px, 5vw, 58px);
      line-height: 1.08;
      letter-spacing: -2px;
    }

    .credentials-heading h2 span {
      color: #a7864e;
    }

    .credentials-heading > p {
      max-width: 340px;
      color: #777;
      font-size: 14px;
      line-height: 1.9;
    }

    .credentials-grid {
      display: grid;
      grid-template-columns: .85fr 1.15fr;
      gap: 25px;
      align-items: stretch;
    }

    .udyam-card,
    .gst-card {
