  <!-- HOMEPAGE JAVASCRIPT -->
  <script>

    // GST CERTIFICATE SLIDER

    const gstModal = document.querySelector("#gstModal");
    const gstSlider = document.querySelector("#gstSlider");
    const gstCounter = document.querySelector("#gstCounter");

    const openGST = document.querySelector("#openGST");
    const closeGST = document.querySelector("#gstClose");
    const prevGST = document.querySelector("#gstPrev");
    const nextGST = document.querySelector("#gstNext");

    if (
      gstModal &&
      gstSlider &&
      gstCounter &&
      openGST &&
      closeGST &&
      prevGST &&
      nextGST
    ) {

      let gstPage = 0;

      const totalGSTPages = gstSlider.querySelectorAll("img").length;

      function updateGSTPage() {

        gstSlider.style.transform =
          `translateX(-${gstPage * 100}%)`;

        gstCounter.textContent =
          `PAGE ${String(gstPage + 1).padStart(2, "0")} / ${String(totalGSTPages).padStart(2, "0")}`;

      }

      function openCertificate() {

        gstPage = 0;
        updateGSTPage();

        gstModal.classList.add("active");
        gstModal.setAttribute("aria-hidden", "false");

        document.body.style.overflow = "hidden";

        closeGST.focus();

      }

      function closeCertificate() {

        gstModal.classList.remove("active");
        gstModal.setAttribute("aria-hidden", "true");

        document.body.style.overflow = "";

        openGST.focus();

      }

      function nextPage() {

        gstPage = (gstPage + 1) % totalGSTPages;
        updateGSTPage();

      }

      function previousPage() {

        gstPage = (gstPage - 1 + totalGSTPages) % totalGSTPages;
        updateGSTPage();

      }

      openGST.addEventListener("click", openCertificate);

      closeGST.addEventListener("click", closeCertificate);

      nextGST.addEventListener("click", nextPage);

      prevGST.addEventListener("click", previousPage);

      gstModal.addEventListener("click", (event) => {

        if (event.target === gstModal) {
          closeCertificate();
        }

      });

      document.addEventListener("keydown", (event) => {

        if (!gstModal.classList.contains("active")) return;

        if (event.key === "Escape") {
          closeCertificate();
        }

        if (event.key === "ArrowRight") {
          nextPage();
        }

        if (event.key === "ArrowLeft") {
          previousPage();
        }

      });

      // MOBILE SWIPE

      let touchStartX = 0;

      gstSlider.addEventListener("touchstart", (event) => {

        touchStartX = event.changedTouches[0].screenX;

      }, { passive: true });

      gstSlider.addEventListener("touchend", (event) => {

        const touchEndX = event.changedTouches[0].screenX;

        const difference = touchStartX - touchEndX;

        if (Math.abs(difference) > 50) {

          if (difference > 0) {
            nextPage();
          } else {
            previousPage();
          }

        }

      }, { passive: true });

    }


    // TESTIMONIAL SLIDER

    const track = document.querySelector(".testimonial-track");

    const prev = document.querySelector(".testimonial-prev");

    const next = document.querySelector(".testimonial-next");

    const current = document.querySelector(".testimonial-current");

    const total = document.querySelector(".testimonial-total");

    const progress = document.querySelector(".pagination-line span");


    if (track && prev && next && current && total && progress) {

      const cards = [...track.querySelectorAll(".testimonial-card")];

      const getStep = () => {

        const card = cards[0];

        if (!card) return 0;

        const gap = parseFloat(getComputedStyle(track).gap) || 0;

        return card.getBoundingClientRect().width + gap;

      };


      const updateSlider = () => {

        const step = getStep();

        if (!step) return;

        const index = Math.round(track.scrollLeft / step);

        const maxIndex = Math.max(
          0,
          Math.ceil((track.scrollWidth - track.clientWidth) / step)
        );

        const safeIndex = Math.min(index, maxIndex);

        current.textContent =
          String(safeIndex + 1).padStart(2, "0");

        total.textContent =
          String(maxIndex + 1).padStart(2, "0");

        progress.style.width =
          `${((safeIndex + 1) / (maxIndex + 1)) * 100}%`;

        prev.disabled = track.scrollLeft <= 2;

        next.disabled =
          track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;

      };


      next.addEventListener("click", () => {

        track.scrollBy({
          left: getStep(),
          behavior: "smooth"
        });

      });


      prev.addEventListener("click", () => {

        track.scrollBy({
          left: -getStep(),
          behavior: "smooth"
        });

      });


      track.addEventListener("scroll", updateSlider, {
        passive: true
      });

      window.addEventListener("resize", updateSlider);

      updateSlider();

    }

  </script>

