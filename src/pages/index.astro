.udyam-section {
  padding: 110px 0;
  background: #F5F3EE;
}

.udyam-layout {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  min-height: 510px;
  overflow: hidden;
  background: #FFFFFF;
  border: 1px solid #EAE6DE;
  box-shadow: 0 20px 60px rgba(40, 35, 25, .06);
}

/* IMAGE */

.udyam-image {
  position: relative;
  min-height: 510px;
  overflow: hidden;
}

.udyam-image img {
  width: 100%;
  height: 100%;
  min-height: 510px;
  object-fit: cover;
  transition: transform .8s ease;
}

.udyam-layout:hover .udyam-image img {
  transform: scale(1.04);
}

.udyam-image::after {
  content: "";
  position: absolute;
  inset: 50% 0 0;
  background: linear-gradient(transparent, rgba(20, 20, 20, .55));
}

.udyam-image-caption {
  position: absolute;
  z-index: 2;
  bottom: 28px;
  left: 30px;
  right: 30px;
  display: flex;
  justify-content: space-between;
  gap: 15px;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

/* CONTENT */

.udyam-content {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 65px 55px;
  overflow: hidden;
  color: #252B32;
