
---
import MainLayout from "../layouts/MainLayout.astro";
import { business } from "../data/site.js";
import contactImg from "../../public/images/contact.webp";
---

<MainLayout
  title="Contact SS Traders Mattress | Aligarh, Uttar Pradesh"
  description="Contact SS Traders Mattress in Aligarh for quality mattresses, foam products and enquiries."
>
  <!-- Contact Hero -->
  <section class="contact-hero">
    <div class="container">
      <span class="eyebrow">GET IN TOUCH</span>
      <h1>Let's talk <span>comfort.</span></h1>
      <p>
        Have a question or looking for the right mattress?
        We're here to help you find the perfect comfort.
      </p>
    </div>
  </section>

  <!-- Contact Details + Enquiry -->
  <section class="contact-section">
    <div class="contact-grid container">

      <!-- Left: Contact Information -->
      <div class="contact-info">
        <span class="eyebrow">CONTACT INFORMATION</span>
        <h2>We'd love to<br />hear from you.</h2>
        <p class="info-description">
          Get in touch with SS Traders Mattress for product enquiries,
          pricing and assistance.
        </p>

        <div class="info-item">
          <div class="info-icon">☎</div>
          <div>
            <span>Call / WhatsApp</span>
            <a href={`tel:${business.phone}`}>{business.phone}</a>
          </div>
        </div>

        <div class="info-item">
          <div class="info-icon">✉</div>
          <div>
            <span>Email</span>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </div>
        </div>

        <div class="info-item">
          <div class="info-icon">⌖</div>
          <div>
            <span>Visit Our Store</span>
            <p>{business.address}</p>
            <a
              class="direction-link"
              href="https://www.google.com/maps/search/?api=1&query=SS+Traders+Aligarh"
              target="_blank"
              rel="noopener noreferrer"
            >
              Get directions ↗
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Enquiry Card -->
      <div class="enquiry-card">
        <span class="eyebrow">QUICK ENQUIRY</span>
        <h2>How can we help you?</h2>
        <p>Share your requirements and we'll get back to you.</p>

        <form
          action={`https://wa.me/${String(business.phone).replace(/\D/g, "")}`}
          method="get"
          target="_blank"
          id="contactForm"
        >
          <label for="name">Your Name</label>
          <input
            type="text"
            id="name"
            name="text"
            placeholder="Enter your name"
            required
          />

          <label for="phone">Phone Number</label>
          <input
            type="tel"
            id="phone"
            placeholder="Enter your phone number"
            required
          />

          <label for="message">Your Message</label>
          <textarea
            id="message"
            placeholder="Tell us what you're looking for..."
            rows="4"
            required
          ></textarea>

          <button type="submit" class="submit-btn">
            Send Enquiry <span>↗</span>
          </button>
        </form>
      </div>

    </div>
  </section>

  <!-- Full Width Store Photo -->
  <section class="store-photo-section">
    <img
      src={contactImg.src}
      alt="SS Traders Mattress Store"
      loading="lazy"
    />
  </section>

  <!-- Full Width Map -->
  <section class="map-section">
    <div class="map-heading">
      <span class="eyebrow">FIND US</span>
      <h2>Visit Our <span>Store.</span></h2>
      <p>Come visit SS Traders Mattress in Aligarh.</p>
    </div>

    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d881.2267674271507!2d78.08635218531951!3d27.935494029676523!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3974a5f96742ad9d%3A0x74cce8d0afa6f3b2!2sSS%20Traders!5e0!3m2!1sen!2sin!4v1794393304538!5m2!1sen!2sin"
      width="100%"
      height="450"
      style="border:0;"
      allowfullscreen
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      title="SS Traders Mattress Location"
    ></iframe>
  </section>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    .container {
      width: min(1200px, calc(100% - 48px));
      margin-inline: auto;
    }

    .contact-hero {
      background: #002556;
      color: #fff;
      padding: 100px 0 95px;
    }

    .eyebrow {
      display: block;
      color: #C6A15B;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      margin-bottom: 20px;
    }

    .contact-hero h1 {
      font-size: clamp(42px, 6vw, 76px);
      line-height: 1.05;
      letter-spacing: -3px;
      font-weight: 600;
      margin: 0 0 22px;
    }

    .contact-hero h1 span,
    .map-heading h2 span {
      color: #C6A15B;
    }

    .contact-hero p {
      color: rgba(255,255,255,.75);
      max-width: 520px;
      line-height: 1.8;
      font-size: 15px;
    }

    .contact-section {
      padding: 100px 0;
      background: #F5F6F8;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: .85fr 1.15fr;
      gap: 80px;
      align-items: start;
    }

    .contact-info h2 {
      color: #002556;
      font-size: clamp(34px, 4vw, 48px);
      line-height: 1.15;
      letter-spacing: -1.5px;
      margin: 0 0 20px;
    }

    .info-description {
      color: #777;
      line-height: 1.8;
      max-width: 400px;
      margin-bottom: 40px;
      font-size: 14px;
    }

    .info-item {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      margin-top: 30px;
    }

    .info-icon {
      width: 46px;
      height: 46px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      background: #fff;
      color: #C6A15B;
      border: 1px solid #e8e8e8;
      border-radius: 50%;
      font-size: 20px;
    }

    .info-item span {
      display: block;
      color: #888;
      font-size: 12px;
      margin-bottom: 8px;
    }

    .info-item a,
    .info-item p {
      color: #002556;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      line-height: 1.7;
      margin: 0;
    }

    .info-item .direction-link {
      display: inline-block;
      color: #A47D3F;
      font-size: 12px;
      margin-top: 8px;
    }

    .enquiry-card {
      background: #fff;
      padding: 42px;
      border-radius: 8px;
      border: 1px solid #e9e9e9;
    }

    .enquiry-card h2 {
      color: #002556;
      font-size: 30px;
      margin: 0 0 12px;
      letter-spacing: -1px;
    }

    .enquiry-card > p {
      color: #888;
      font-size: 14px;
      margin-bottom: 30px;
    }

    .enquiry-card form {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .enquiry-card label {
      color: #002556;
      font-size: 12px;
      font-weight: 600;
      margin-top: 8px;
    }

    .enquiry-card input,
    .enquiry-card textarea {
      width: 100%;
      padding: 15px;
      border: 1px solid #e5e5e5;
      background: #FAFAFA;
      color: #222;
      outline: none;
      font: inherit;
      font-size: 13px;
      border-radius: 4px;
    }

    .enquiry-card input:focus,
    .enquiry-card textarea:focus {
      border-color: #C6A15B;
    }

    .enquiry-card textarea {
      resize: vertical;
    }

    .submit-btn {
      margin-top: 15px;
      border: 0;
      background: #002556;
      color: #fff;
      padding: 17px 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: background .3s ease;
    }

    .submit-btn:hover {
      background: #C6A15B;
      color: #002556;
    }

    /* Full width photo */
    .store-photo-section {
      width: 100%;
      height: clamp(280px, 48vw, 600px);
      overflow: hidden;
      background: #eee;
    }

    .store-photo-section img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: center;
    }

    /* Full width map */
    .map-section {
      width: 100%;
      background: #fff;
    }

    .map-heading {
      text-align: center;
      padding: 75px 24px 40px;
    }

    .map-heading .eyebrow {
      margin-bottom: 12px;
    }

    .map-heading h2 {
      color: #002556;
      font-size: clamp(34px, 4vw, 48px);
      letter-spacing: -1.5px;
      margin: 0 0 12px;
    }

    .map-heading p {
      color: #888;
      font-size: 14px;
      margin: 0;
    }

    .map-section iframe {
      width: 100%;
      height: 450px;
      display: block;
    }

    @media (max-width: 768px) {
      .container {
        width: calc(100% - 36px);
      }

      .contact-hero {
        padding: 75px 0;
      }

      .contact-hero h1 {
        letter-spacing: -1.5px;
      }

      .contact-section {
        padding: 65px 0;
      }

      .contact-grid {
        grid-template-columns: 1fr;
        gap: 45px;
      }

      .enquiry-card {
        padding: 28px 22px;
      }

      .store-photo-section {
        height: 320px;
      }

      .map-heading {
        padding: 55px 18px 30px;
      }

      .map-section iframe {
        height: 350px;
      }
    }
  </style>

  <script>
    const form = document.querySelector("#contactForm");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      const name = document.querySelector("#name")?.value.trim();
      const phone = document.querySelector("#phone")?.value.trim();
      const message = document.querySelector("#message")?.value.trim();

      const number = String("YOUR_WHATSAPP_NUMBER").replace(/\D/g, "");

      const text = `Hello SS Traders Mattress,

Name: ${name}
Phone: ${phone}
Message: ${message}`;

      window.open(
        `https://wa.me/${number}?text=${encodeURIComponent(text)}`,
        "_blank"
      );
    });
  </script>
</MainLayout>
