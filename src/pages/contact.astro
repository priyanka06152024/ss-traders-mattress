
---
import MainLayout from "../layouts/MainLayout.astro";
import { business } from "../data/site.js";
import contactImg from "../../public/images/contact.webp";

const whatsappNumber = String(business.phone).replace(/\D/g, "");
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(business.address)}`;
---

<MainLayout
  title="Contact SS Traders Mattress | Aligarh, Uttar Pradesh"
  description="Contact SS Traders Mattress in Aligarh for quality mattresses, foam products, pricing and enquiries. Call, WhatsApp or visit our store."
>
  <!-- CONTACT HERO -->

<!-- CONTACT HERO -->
<section class="contact-hero">
  <div class="contact-hero-image" aria-hidden="true"></div>
  <div class="contact-hero-overlay" aria-hidden="true"></div>

  <div class="container contact-hero-content">
    <span class="eyebrow">GET IN TOUCH</span>

    <h1>Let's talk <span>comfort.</span></h1>

    <p>
      Have a question or looking for the right mattress?
      We're here to help you find the perfect comfort.
    </p>

    <a href="#contactForm" class="contact-hero-btn">
      Send an Enquiry <span>↗</span>
    </a>
  </div>

  <div class="contact-hero-decoration" aria-hidden="true">CONTACT</div>
</section>

  <!-- CONTACT DETAILS + ENQUIRY -->
  <section class="contact-section">
    <div class="contact-grid container">

      <!-- LEFT: CONTACT INFORMATION -->
      <div class="contact-info">
        <span class="eyebrow">CONTACT INFORMATION</span>

        <h2>We'd love to<br />hear from you.</h2>

        <p class="info-description">
          Get in touch with SS Traders Mattress for product enquiries,
          pricing and assistance. Our team is always happy to help you
          find the right comfort solution.
        </p>

        <!-- MAIN PHONE -->
        <div class="info-item">
          <div class="info-icon">☎</div>

          <div>
            <span>Main Contact Number · Call / WhatsApp</span>

            <a href={`tel:${business.phone}`}>
              {business.phoneDisplay}
            </a>

            <a
              class="direction-link"
              href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Hello SS Traders Mattress, I would like to enquire about your mattresses.")}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Chat on WhatsApp ↗
            </a>
          </div>
        </div>

        <!-- SECONDARY PHONE -->
        <div class="info-item">
          <div class="info-icon">☎</div>

          <div>
            <span>Secondary Contact Number</span>

            <a href={`tel:${business.secondaryPhone}`}>
              {business.secondaryPhoneDisplay}
            </a>
          </div>
        </div>

        <!-- PRIMARY EMAIL -->
        <div class="info-item">
          <div class="info-icon">✉</div>

          <div>
            <span>Primary Email Address</span>

            <a href={`mailto:${business.email}`}>
              {business.email}
            </a>
          </div>
        </div>

        <!-- ALTERNATE EMAIL -->
        <div class="info-item">
          <div class="info-icon">✉</div>

          <div>
            <span>Alternate Email Address</span>

            <a href={`mailto:${business.alternateEmail}`}>
              {business.alternateEmail}
            </a>
          </div>
        </div>

        <!-- COMPLETE ADDRESS -->
        <div class="info-item">
          <div class="info-icon">⌖</div>

          <div>
            <span>Visit Our Store</span>

            <p class="store-address">
              {business.address}
            </p>

            <a
              class="direction-link"
              href={mapUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Get Directions ↗
            </a>
          </div>
        </div>
      </div>

      <!-- RIGHT: ENQUIRY CARD -->
      <div class="enquiry-card">
        <span class="eyebrow">QUICK ENQUIRY</span>

        <h2>How can we help you?</h2>

        <p>
          Share your requirements and we'll get back to you.
        </p>

        <form id="contactForm" data-whatsapp={whatsappNumber}>

          <label for="name">Your Name</label>

          <input
            type="text"
            id="name"
            name="name"
            placeholder="Enter your name"
            autocomplete="name"
            required
          />

          <label for="phone">Phone Number</label>

          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder="Enter your phone number"
            autocomplete="tel"
            required
          />

          <label for="message">Your Message</label>

          <textarea
            id="message"
            name="message"
            placeholder="Tell us what you're looking for..."
            rows="4"
            required
          ></textarea>

          <button type="submit" class="submit-btn">
            Send Enquiry <span>↗</span>
          </button>

          <p class="form-note">
            Your enquiry will open directly in WhatsApp.
          </p>

        </form>
      </div>

    </div>
  </section>

  <!-- FULL WIDTH STORE PHOTO -->
  <section class="store-photo-section">
    <img
      src={contactImg.src}
      alt="SS Traders Mattress Store"
      loading="lazy"
    />
  </section>

  <!-- GOOGLE MAP -->
  <section class="map-section">

    <div class="map-heading">
      <span class="eyebrow">FIND US</span>

      <h2>Visit Our <span>Store.</span></h2>

      <p>
        Come visit SS Traders Mattress in Aligarh.
        We'd love to welcome you.
      </p>
    </div>

    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d881.2267674271507!2d78.08635218531951!3d27.935494029676523!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3974a5f96742ad9d%3A0x74cce8d0afa6f3b2!2sSS%20Traders!5e0!3m2!1sen!2sin!4v1794393304538!5m2!1sen!2sin"
      width="100%"
      height="450"
      style="border:0;"
      allowfullscreen
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      title="SS Traders Mattress Location"
    ></iframe>

  </section>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    .container {
      width: min(1200px, calc(100% - 48px));
      margin-inline: auto;
    }

    /* CONTACT HERO */

   
/* CONTACT HERO */

.contact-hero {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  min-height: 480px;
  padding: 100px 0;
  overflow: hidden;
  background: #002556;
  color: #fff;
}

.contact-hero-image {
  position: absolute;
  inset: 0;
  z-index: -2;
  background-image: url("/images/hero3.webp");
  background-size: cover;
  background-position: center 55%;
  transform: scale(1.02);
}

.contact-hero-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(
    90deg,
    rgba(0, 25, 58, 0.72) 0%,
    rgba(0, 37, 86, 0.38) 45%,
    rgba(0, 37, 86, 0.08) 100%
  );
}
.contact-hero-content {
  position: relative;
  z-index: 2;
}

.contact-hero h1 {
  font-size: clamp(42px, 6vw, 76px);
  line-height: 1.05;
  letter-spacing: -3px;
  font-weight: 600;
  margin: 0 0 22px;
}

.contact-hero h1 span {
  color: #C6A15B;
}

.contact-hero p {
  color: rgba(255,255,255,.82);
  max-width: 520px;
  line-height: 1.8;
  font-size: 15px;
}

.contact-hero-btn {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 35px;
  margin-top: 28px;
  padding: 16px 22px;
  background: #C6A15B;
  color: #002556;
  font-size: 12px;
  font-weight: 700;
  transition: .3s ease;
}

.contact-hero-btn:hover {
  background: #fff;
  transform: translateY(-3px);
}

.contact-hero-btn span {
  font-size: 17px;
}

.contact-hero-decoration {
  position: absolute;
  right: 4%;
  bottom: -35px;
  color: rgba(255,255,255,.07);
  font-size: clamp(70px, 13vw, 180px);
  font-weight: 900;
  letter-spacing: -8px;
  pointer-events: none;
}

/* RESPONSIVE HERO */

@media (max-width: 768px) {
  .contact-hero {
    min-height: 420px;
    padding: 75px 0;
  }

  .contact-hero-image {
    background-position: 60% center;
  }

  .contact-hero-overlay {
    background: linear-gradient(
      90deg,
      rgba(0, 25, 58, .95),
      rgba(0, 37, 86, .75)
    );
  }

  .contact-hero h1 {
    letter-spacing: -1.5px;
  }

  .contact-hero-decoration {
    font-size: 65px;
    letter-spacing: -3px;
  }
}


    /* CONTACT SECTION */

    .contact-section {
      padding: 100px 0;
      background: #F5F6F8;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: .85fr 1.15fr;
      gap: 80px;
      align-items: start;
    }

    .contact-info h2 {
      color: #002556;
      font-size: clamp(34px, 4vw, 48px);
      line-height: 1.15;
      letter-spacing: -1.5px;
      margin: 0 0 20px;
    }

    .info-description {
      color: #777;
      line-height: 1.8;
      max-width: 400px;
      margin-bottom: 40px;
      font-size: 14px;
    }

    /* CONTACT ITEMS */

    .info-item {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      margin-top: 30px;
    }

    .info-icon {
      width: 46px;
      height: 46px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      background: #fff;
      color: #C6A15B;
      border: 1px solid #e8e8e8;
      border-radius: 50%;
      font-size: 20px;
    }

    .info-item > div:last-child {
      min-width: 0;
    }

    .info-item span {
      display: block;
      color: #888;
      font-size: 12px;
      margin-bottom: 8px;
    }

    .info-item a,
    .info-item p {
      color: #002556;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      line-height: 1.7;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .info-item a {
      transition: color .3s ease;
    }

    .info-item a:hover {
      color: #C6A15B;
    }

    .info-item .direction-link {
      display: inline-block;
      color: #A47D3F;
      font-size: 12px;
      margin-top: 8px;
    }

    .store-address {
      max-width: 430px;
    }

    /* ENQUIRY CARD */

    .enquiry-card {
      background: #fff;
      padding: 42px;
      border-radius: 8px;
      border: 1px solid #e9e9e9;
    }

    .enquiry-card h2 {
      color: #002556;
      font-size: 30px;
      margin: 0 0 12px;
      letter-spacing: -1px;
    }

    .enquiry-card > p {
      color: #888;
      font-size: 14px;
      margin-bottom: 30px;
    }

    .enquiry-card form {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .enquiry-card label {
      color: #002556;
      font-size: 12px;
      font-weight: 600;
      margin-top: 8px;
    }

    .enquiry-card input,
    .enquiry-card textarea {
      width: 100%;
      padding: 15px;
      border: 1px solid #e5e5e5;
      background: #FAFAFA;
      color: #222;
      outline: none;
      font: inherit;
      font-size: 13px;
      border-radius: 4px;
    }

    .enquiry-card input:focus,
    .enquiry-card textarea:focus {
      border-color: #C6A15B;
    }

    .enquiry-card textarea {
      resize: vertical;
    }

    .submit-btn {
      margin-top: 15px;
      border: 0;
      background: #002556;
      color: #fff;
      padding: 17px 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: background .3s ease;
    }

    .submit-btn:hover {
      background: #C6A15B;
      color: #002556;
    }

    .form-note {
      color: #999;
      font-size: 11px;
      line-height: 1.6;
      margin: 5px 0 0;
    }

    /* STORE PHOTO */

    .store-photo-section {
      width: 100%;
      height: clamp(280px, 48vw, 600px);
      overflow: hidden;
      background: #eee;
    }

    .store-photo-section img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: center;
    }

    /* GOOGLE MAP */

    .map-section {
      width: 100%;
      background: #fff;
    }

    .map-heading {
      text-align: center;
      padding: 75px 24px 40px;
    }

    .map-heading .eyebrow {
      margin-bottom: 12px;
    }

    .map-heading h2 {
      color: #002556;
      font-size: clamp(34px, 4vw, 48px);
      letter-spacing: -1.5px;
      margin: 0 0 12px;
    }

    .map-heading p {
      color: #888;
      font-size: 14px;
      margin: 0;
      line-height: 1.8;
    }

    .map-section iframe {
      width: 100%;
      height: 450px;
      display: block;
    }

    /* RESPONSIVE */

    @media (max-width: 768px) {
      .container {
        width: calc(100% - 36px);
      }

      .contact-hero {
        padding: 75px 0;
      }

      .contact-hero h1 {
        letter-spacing: -1.5px;
      }

      .contact-section {
        padding: 65px 0;
      }

      .contact-grid {
        grid-template-columns: 1fr;
        gap: 45px;
      }

      .enquiry-card {
        padding: 28px 22px;
      }

      .enquiry-card h2 {
        font-size: 26px;
      }

      .store-photo-section {
        height: 320px;
      }

      .map-heading {
        padding: 55px 18px 30px;
      }

      .map-section iframe {
        height: 350px;
      }

      .info-item {
        gap: 14px;
      }

      .info-item a,
      .info-item p {
        font-size: 14px;
      }
    }

    @media (max-width: 380px) {
      .enquiry-card {
        padding: 24px 17px;
      }

      .info-icon {
        width: 40px;
        height: 40px;
      }
    }
  </style>

  <!-- WHATSAPP FORM SCRIPT -->
  <script>
    const form = document.querySelector<HTMLFormElement>("#contactForm");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      const name = (
        document.querySelector<HTMLInputElement>("#name")?.value || ""
      ).trim();

      const phone = (
        document.querySelector<HTMLInputElement>("#phone")?.value || ""
      ).trim();

      const message = (
        document.querySelector<HTMLTextAreaElement>("#message")?.value || ""
      ).trim();

      if (!name || !phone || !message) {
        return;
      }

      const number = form.dataset.whatsapp;

      if (!number) {
        return;
      }

      const whatsappMessage = `Hello SS Traders Mattress,

Name: ${name}
Phone: ${phone}
Message: ${message}`;

      const whatsappUrl =
        `https://wa.me/${number}?text=${encodeURIComponent(whatsappMessage)}`;

      window.open(whatsappUrl, "_blank", "noopener,noreferrer");
    });
  </script>
</MainLayout>
