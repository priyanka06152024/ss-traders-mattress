
---
const { business } = Astro.props;

const phone = business?.phone || "";
const phoneLink = phone.replace(/[^\d+]/g, "");


const slides = [
  {
    eyebrow: "SS TRADERS MATTRESS",
    title: "Sleep Better.",
    highlight: "Live Better.",
    description:
      "Experience the perfect combination of comfort, support and quality for a better night's sleep.",
    image: "/images/hero1.webp",
    alt: "Beautiful modern bedroom with a comfortable bed",
  },
  {
    eyebrow: "COMFORT THAT LASTS",
    title: "Comfort Made",
    highlight: "For You.",
    description:
      "Discover quality mattresses designed to make every moment of rest more comfortable.",
    image: "/images/hero2.webp",
    alt: "Elegant bedroom with premium bedding",
  },
  {
    eyebrow: "QUALITY YOU CAN TRUST",
    title: "The Right Support.",
    highlight: "Every Night.",
    description:
      "Explore our range of orthopedic, foam, rebonded and spring mattresses.",
    image: "/images/hero3.webp",
    alt: "Comfortable bedroom interior",
  },
  {
    eyebrow: "YOUR BETTER SLEEP STARTS HERE",
    title: "Make Every",
    highlight: "Night Better.",
    description:
      "Find the right mattress for your sleeping needs, comfort and budget.",
    image:
      "https://images.unsplash.com/photo-1616594039964-ae9021a400a0?auto=format&fit=crop&w=2000&q=85",
    alt: "Warm and inviting bedroom",
  },
];
---

<section class="hero-slider" aria-label="SS Traders Mattress highlights">
  <div class="hero-backgrounds">
    {slides.map((slide, index) => (
      <div
        class:list={["hero-slide", { "is-active": index === 0 }]}
        data-slide
        aria-hidden={index !== 0}
      >
        <img
          src={slide.image}
          alt={slide.alt}
          loading={index === 0 ? "eager" : "lazy"}
        />
      </div>
    ))}
  </div>

  <div class="hero-overlay"></div>

  <button type="button" class="hero-arrow hero-prev" id="hero-prev" aria-label="Previous slide">
    <span>←</span>
  </button>

  <button type="button" class="hero-arrow hero-next" id="hero-next" aria-label="Next slide">
    <span>→</span>
  </button>

  <div class="hero-inner">
    <div class="hero-copy">
      {slides.map((slide, index) => (
        <div
          class:list={["hero-content", { "is-active": index === 0 }]}
          data-content
          aria-hidden={index !== 0}
        >
          <span class="hero-eyebrow">{slide.eyebrow}</span>

          <h1>
            {slide.title}
            <span>{slide.highlight}</span>
          </h1>

          <p>{slide.description}</p>

          <div class="hero-actions">
            <a href="/products" class="hero-btn hero-btn-primary">
              Explore Products <span>↗</span>
            </a>

            <a
              href={phoneLink ? `tel:${phoneLink}` : "/contact"}
              class="hero-btn hero-btn-outline"
            >
              Contact Us
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-slider {
    position: relative;
    min-height: 690px;
    height: min(790px, 88vh);
    overflow: hidden;
    background: #002556;
    color: #fff;
    isolation: isolate;
  }

  .hero-backgrounds,
  .hero-slide,
  .hero-overlay {
    position: absolute;
    inset: 0;
  }

  .hero-slide {
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s ease, visibility 1s ease;
  }

  .hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 5s ease;
  }

  .hero-slide.is-active img {
    transform: scale(1);
  }

 .hero-overlay {
  background: linear-gradient(
    90deg,
    rgba(15, 15, 15, 0.48) 0%,
    rgba(15, 15, 15, 0.20) 50%,
    rgba(15, 15, 15, 0.04) 100%
  );
}
  .hero-inner {
    position: relative;
    z-index: 3;
    width: min(1200px, calc(100% - 150px));
    height: 100%;
    min-height: 690px;
    margin: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 100px 0;
  }

  .hero-copy {
    position: relative;
    min-height: 340px;
  }

  .hero-content {
    position: absolute;
    inset: 0 auto auto 0;
    width: min(680px, 100%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(25px);
    transition:
      opacity .7s ease,
      transform .7s ease,
      visibility .7s ease;
  }

  .hero-content.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .hero-eyebrow {
    display: inline-block;
    margin-bottom: 24px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #fec73a;
  }

  .hero-content h1 {
    margin: 0;
    font-size: clamp(48px, 7vw, 88px);
    line-height: .99;
    letter-spacing: -4px;
    font-weight: 600;
    color: #fff;
  }

  .hero-content h1 span {
    display: block;
    color: #fec73a;
  }

  .hero-content p {
    max-width: 490px;
    margin: 26px 0 30px;
    font-size: 16px;
    line-height: 1.8;
    color: rgba(255, 255, 255, .85);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    min-height: 52px;
    padding: 0 24px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .5px;
    transition: .3s ease;
  }

.hero-btn-primary {
  background: #C6A15B;
  color: #002556;
}

.hero-btn-primary:hover {
  background: #FFFFFF;
  color: #002556;
}

.hero-btn-outline {
  border: 1px solid rgba(255, 255, 255, 0.7);
  color: #FFFFFF;
}

.hero-btn-outline:hover {
  background: #FFFFFF;
  border-color: #FFFFFF;
  color: #002556;
}

/* Gold accents */
.hero-eyebrow,
.hero-content h1 span {
  color: #C6A15B;
}

/* Slider arrows */
.hero-arrow:hover {
  background: #C6A15B;
  border-color: #C6A15B;
  color: #002556;
}

  @media (max-width: 768px) {
    .hero-slider {
      height: 720px;
      min-height: 650px;
    }

    .hero-inner {
      width: calc(100% - 100px);
      min-height: 650px;
      padding: 80px 0;
    }

    .hero-copy {
      min-height: 360px;
    }

    .hero-content h1 {
      font-size: clamp(46px, 11vw, 68px);
      letter-spacing: -2.5px;
    }

    .hero-content p {
      font-size: 14px;
      max-width: 400px;
    }

    .hero-arrow {
      width: 38px;
      height: 38px;
      font-size: 19px;
    }

    .hero-prev {
      left: 12px;
    }

    .hero-next {
      right: 12px;
    }
  }

  @media (max-width: 420px) {
    .hero-slider {
      height: 680px;
      min-height: 620px;
    }

    .hero-inner {
      min-height: 620px;
      width: calc(100% - 76px);
    }

    .hero-copy {
      min-height: 370px;
    }

    .hero-content h1 {
      font-size: 43px;
    }

    .hero-content p {
      font-size: 13px;
      line-height: 1.7;
    }

    .hero-btn {
      min-height: 46px;
      padding: 0 13px;
      gap: 10px;
      font-size: 11px;
    }

    .hero-arrow {
      width: 32px;
      height: 32px;
      font-size: 17px;
    }

    .hero-prev {
      left: 7px;
    }

    .hero-next {
      right: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-slide img,
    .hero-content {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll(".hero-slider").forEach((slider) => {
    if (slider.dataset.initialized === "true") return;

    const slides = [...slider.querySelectorAll("[data-slide]")];
    const contents = [...slider.querySelectorAll("[data-content]")];
    const prev = slider.querySelector("#hero-prev");
    const next = slider.querySelector("#hero-next");

    if (slides.length < 2 || contents.length !== slides.length) {
      console.error("Hero slider: Please add at least 2 matching slides and content blocks.");
      return;
    }

    slider.dataset.initialized = "true";

    const duration = 4000;
    let activeIndex = 0;
    let timer;

    function updateSlide(index) {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === activeIndex;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });

      contents.forEach((content, i) => {
        const active = i === activeIndex;
        content.classList.toggle("is-active", active);
        content.setAttribute("aria-hidden", String(!active));
      });
    }

    function startAutoplay() {
      clearInterval(timer);

      timer = window.setInterval(() => {
        updateSlide(activeIndex + 1);
      }, duration);
    }

    prev?.addEventListener("click", () => {
      updateSlide(activeIndex - 1);
      startAutoplay();
    });

    next?.addEventListener("click", () => {
      updateSlide(activeIndex + 1);
      startAutoplay();
    });

    startAutoplay();
  });
</script>
