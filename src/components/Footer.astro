
---
import { business } from "../data/site.js";
import logo from "../../public/images/ss-logo.png";

const socialLinks = [
  {
    name: "Instagram",
    url: "https://www.instagram.com/sstradersmattress",
    icon: "instagram",
  },
  {
    name: "Facebook",
    url: "https://www.facebook.com/shahwaz.chaudhary.2025/reels/",
    icon: "facebook",
  },
  {
    name: "IndiaMART",
    url: "https://www.indiamart.com/ss-traders-aligarh/other-products.html",
    icon: "store",
  },
  {
    name: "Justdial",
    url: "https://www.justdial.com/Aligarh/S-S-Traders-Nearby-Saleem-Ki-Puliya-Jamalpur/",
    icon: "map",
  },
];
---

<footer class="bg-[var(--navy-deep)] text-white">
  <div class="container-wide grid gap-12 py-14 md:grid-cols-[1.2fr_.8fr_1fr] md:py-16">

    <!-- BRAND -->
    <div>
      <a href="/" class="inline-flex rounded-xl bg-white p-2">
        <img
          src={logo.src}
          alt="SS Traders Mattress logo"
          width="190"
          height="128"
          class="h-16 w-auto object-contain"
          loading="lazy"
        />
      </a>

      <p class="mt-5 max-w-sm text-sm leading-7 text-white/70">
        Quality comfort for better sleep. Explore mattress and foam options
        with SS Traders Mattress in Aligarh.
      </p>

      <!-- SOCIAL LINKS -->
      <h3 class="mt-7 text-xs font-bold uppercase tracking-[.16em] text-[var(--gold-light)]">
        Follow & Connect
      </h3>

      <div class="mt-4 flex flex-wrap gap-3">
        {socialLinks.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit SS Traders on ${social.name}`}
            title={social.name}
            class="grid size-10 place-items-center rounded-full border border-white/20 text-white/75 transition duration-300 hover:border-[var(--gold)] hover:bg-[var(--gold)] hover:text-[var(--navy-deep)]"
          >
            {social.icon === "instagram" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-[19px]">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            )}

            {social.icon === "facebook" && (
              <svg viewBox="0 0 24 24" fill="currentColor" class="size-[19px]">
                <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.8-.1-1.6-.2-2.4-.2-2.5 0-4.2 1.5-4.2 4.3v2.2H7.5V13h2.7v8h3.3Z" />
              </svg>
            )}

            {social.icon === "store" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-[19px]">
                <path d="M3 10h18l-2-6H5l-2 6Z" />
                <path d="M4 10v10h16V10" />
                <path d="M9 20v-6h6v6" />
                <path d="M3 10a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" />
              </svg>
            )}

            {social.icon === "map" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-[19px]">
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <!-- EXPLORE -->
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[.16em] text-[var(--gold-light)]">
        Explore
      </h2>

      <ul class="mt-5 space-y-3 text-sm text-white/75">
        <li>
          <a class="transition hover:text-[var(--gold-light)]" href="/">Home</a>
        </li>
        <li>
          <a class="transition hover:text-[var(--gold-light)]" href="/about/">About Us</a>
        </li>
        <li>
          <a class="transition hover:text-[var(--gold-light)]" href="/products/">Our Products</a>
        </li>
        <li>
          <a class="transition hover:text-[var(--gold-light)]" href="/contact/">Contact Us</a>
        </li>
      </ul>

      <h3 class="mt-8 text-xs font-bold uppercase tracking-[.16em] text-[var(--gold-light)]">
        Our Online Presence
      </h3>

      <ul class="mt-4 space-y-3 text-sm text-white/75">
        {socialLinks.map((social) => (
          <li>
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="transition hover:text-[var(--gold-light)]"
            >
              {social.name} ↗
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- CONTACT -->
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[.16em] text-[var(--gold-light)]">
        Get in Touch
      </h2>

      <ul class="mt-5 space-y-3 break-words text-sm leading-6 text-white/75">
        <li>
          <a href={`tel:${business.phone}`} class="transition hover:text-[var(--gold-light)]">
            {business.phoneDisplay}
          </a>
        </li>

        <li>
          <a href={`mailto:${business.email}`} class="transition hover:text-[var(--gold-light)]">
            {business.email}
          </a>
        </li>

        <li>{business.shortAddress}</li>
      </ul>

      <a
        href={`https://wa.me/${business.phone.replace(/\D/g, "")}?text=${encodeURIComponent("Hello SS Traders Mattress, I would like to enquire about your mattresses.")}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary mt-7 inline-flex items-center gap-2"
      >
        Enquire on WhatsApp <span aria-hidden="true">↗</span>
      </a>
    </div>

  </div>

  <!-- BOTTOM BAR -->
  <div class="border-t border-white/10">
    <div class="container-wide flex flex-col gap-2 py-5 text-xs text-white/55 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {new Date().getFullYear()} SS Traders Mattress. All rights reserved.
      </p>

      <p>Designed for comfort. Built for the web.</p>
    </div>
  </div>
</footer>
