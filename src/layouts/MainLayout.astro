
---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { business } from "../data/site.js";

const {
  title = "SS Traders Mattress | Mattresses & Foam Products in Aligarh",
  description = "Explore orthopedic, foam, rebonded, spring, memory foam, PU foam and HR foam mattresses at SS Traders Mattress, Aligarh, Uttar Pradesh.",
  canonical = Astro.url.href,
} = Astro.props;

const mainPhone = "+918273238363";

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: business.name,
  url: business.website,
  telephone: business.phone,
  email: business.email,
  description,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Dhorra Quarsi Bypass Road, In Front of Saleem Wali Puliya, FN/2, Fatehnagar, Maheshpur Masjid, Abu Bakar Gali",
    addressLocality: "Aligarh",
    addressRegion: "Uttar Pradesh",
    postalCode: "202002",
    addressCountry: "IN",
  },
};

const whatsappMessage = encodeURIComponent(
  "Hello SS Traders Mattress, I would like to know more about your products."
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#082653" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SS Traders Mattress" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={`${business.website}/images/ss-traders-logo.jpeg`}
    />

    <title>{title}</title>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  </head>

  <body>
    <!-- SKIP TO MAIN CONTENT -->
    <a
      href="#main-content"
      class="sr-only z-[100] rounded bg-white p-3 text-[var(--navy)] focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Skip to main content
    </a>

    <Navbar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- FLOATING CALL & WHATSAPP BUTTONS -->
    <div class="fixed bottom-5 right-5 z-[100] flex flex-col items-center gap-3">

      <!-- CALL BUTTON -->
      <a
        href={`tel:${mainPhone}`}
        aria-label="Call SS Traders Mattress at +91 82732 38363"
        title="Call Now: +91 82732 38363"
        class="grid size-14 place-items-center rounded-full bg-[var(--navy)] text-white shadow-xl transition duration-300 hover:-translate-y-1 hover:bg-[var(--gold)] hover:text-[var(--navy)]"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-6"
          aria-hidden="true"
        >
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 11.19 18.8a19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.08 3.18 2 2 0 0 1 4.07 1h3a2 2 0 0 1 2 1.72c.12.96.35 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.05 8.9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.35 1.84.58 2.8.7a2 2 0 0 1 1.77 2.04Z" />
        </svg>
      </a>

      <!-- WHATSAPP BUTTON -->
      <a
        href={`https://wa.me/${mainPhone.replace(/\D/g, "")}?text=${whatsappMessage}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat with SS Traders Mattress on WhatsApp"
        title="Chat on WhatsApp"
        class="grid size-14 place-items-center rounded-full bg-[#25D366] text-white shadow-xl transition duration-300 hover:-translate-y-1 hover:bg-[#1ebe5d]"
      >
        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-7"
          aria-hidden="true"
        >
          <path d="M20.52 3.48A11.8 11.8 0 0 0 12.13 0C5.6 0 .3 5.3.3 11.82c0 2.08.54 4.11 1.57 5.9L.2 24l6.44-1.69a11.8 11.8 0 0 0 5.49 1.36h.01c6.52 0 11.82-5.3 11.82-11.82 0-3.16-1.23-6.13-3.44-8.37ZM12.14 21.66a9.8 9.8 0 0 1-4.99-1.37l-.36-.21-3.82 1 1.02-3.72-.24-.38a9.8 9.8 0 1 1 8.39 4.68Zm5.38-7.34c-.3-.15-1.77-.87-2.05-.97-.28-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.8-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.09 4.49.71.31 1.26.5 1.69.64.71.22 1.36.19 1.87.11.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z" />
        </svg>
      </a>

    </div>
  </body>
</html>
